<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config (debug and release builds alike).
  - Cleartext permitted, because Android can't scope it by address range.
    The app enforces the rule itself (#194): plain http:// only to a server
    on your own network that you confirmed (src/lib/local-address.js,
    src/lib/plain-http.js, LocalAddress.kt for the background worker), and
    every other request stays HTTPS.
  - System + user CAs trusted: self-hosters can install their own CA
    for self-signed certs via Settings → Security → Install certificate,
    no APK rebuild needed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
