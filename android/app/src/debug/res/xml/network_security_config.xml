<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG override (used by assembleDebug only). Resource overlay merging
  swaps this in for debug-signed APKs; release builds use the config in
  src/main/res/xml/, which now permits cleartext too (#194). In both, the
  app itself allows plain http:// only to a confirmed server on your own
  network (src/lib/plain-http.js).
  - Cleartext permitted: connect to `http://192.168.x.x:3000` and
    emulator dev servers without HTTPS setup.
  - User CAs trusted: install your own CA for testing self-signed certs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
